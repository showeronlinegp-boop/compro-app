# Compro backend environment variables
# Copy this file to .env and fill in your values.

# -- Database (PostgreSQL via Prisma) -----------------------------------------
# Primary database URL. Used by both the app runtime and Prisma migrations.
# connection_limit=25 recommended to cover enricher max concurrency (htmlConc=20 + headroom).
# See design section 4 -- Concurrency concern: enricher runPool uses up to 20 concurrent updates.
DATABASE_URL="postgresql://compro:compro@localhost:5433/compro?connection_limit=25"

# Test database URL (separate DB on the same Postgres instance).
# Used by vitest globalSetup to run prisma migrate deploy against compro_test.
DATABASE_URL_TEST="postgresql://compro:compro@localhost:5433/compro_test"

# -- App -----------------------------------------------------------------------
PORT=3001

# Compras (comparador de supermercados, crawler y crons). Sólo dev y tests:
# sin esta línea (como en la imagen Docker de producción) la app sale sólo con Fiado.
ENABLE_COMPARADOR=true

# Notas de prueba ("Marcar en pantalla"). Sólo desarrollo local: con
# NODE_ENV=production el backend se niega a arrancar si está en 1.
# TEST_NOTES_ENABLED=1

# Panel de uso (/api/admin/uso). Clerk user IDs (user_...) separados por coma.
# Vacía = nadie es admin (la ruta responde 403).
# ADMIN_CLERK_USER_IDS=user_...
# Cuentas de prueba que no cuentan en las métricas (los admins ya quedan afuera).
# METRICAS_EXCLUIR_CLERK_USER_IDS=user_...,user_...

# -- External services ---------------------------------------------------------
# Server-side LLM key. NEVER expose in the frontend (Vite would ship it to the browser).
DEEPSEEK_API_KEY=sk-...