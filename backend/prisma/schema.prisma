// Prisma schema for compro-app — PostgreSQL target
// All model fields use snake_case to match the existing ProductRow / raw SQL contract.
// This avoids rewriting parseRow, types.ts, and the serialization layer (Slice B scope).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// products
// ---------------------------------------------------------------------------
model products {
  id          Int       @id @default(autoincrement())
  super       String    @db.Text
  product_id  String    @db.Text
  sku_id      String?   @db.Text
  name        String    @db.Text
  barcode     String?   @db.Text
  image_url   String?   @db.Text
  product_url String?   @db.Text
  raw_price   Float?    @db.DoublePrecision
  offer_price Float?    @db.DoublePrecision
  discount_pct Int      @default(0)
  available   Boolean   @default(true)
  categories  Json?     @db.JsonB
  promotions  Json?     @db.JsonB
  synced_at   DateTime  @default(now()) @db.Timestamptz(6)

  category_key String?   @db.Text
  brand_tier   Int?      @db.SmallInt

  interests   interests[]
  shopping    shopping[]

  @@unique([super, product_id])
  @@index([super])
  @@index([discount_pct])
  @@index([category_key])
  @@index([brand_tier])
  @@map("products")
}

// ---------------------------------------------------------------------------
// interests
// ---------------------------------------------------------------------------
model interests {
  id         Int      @id @default(autoincrement())
  product_id Int
  added_at   DateTime @default(now()) @db.Timestamptz(6)

  product    products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("interests")
}

// ---------------------------------------------------------------------------
// shopping
// ---------------------------------------------------------------------------
model shopping {
  id             Int       @id @default(autoincrement())
  product_id     Int
  frequency_days Int       @default(7)
  last_bought    DateTime? @db.Timestamptz(6)
  notes          String?   @db.Text
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  product        products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("shopping")
}

// ---------------------------------------------------------------------------
// sync_log
// ---------------------------------------------------------------------------
model sync_log {
  id            Int       @id @default(autoincrement())
  super         String    @db.Text
  started_at    DateTime? @db.Timestamptz(6)
  finished_at   DateTime? @db.Timestamptz(6)
  product_count Int?
  status        String    @default("pending") @db.Text
  error         String?   @db.Text
  progress_leaf Int       @default(0)
  total_leaves  Int       @default(0)

  @@map("sync_log")
}

// ---------------------------------------------------------------------------
// brand_rules
// ---------------------------------------------------------------------------
model brand_rules {
  id           Int    @id @default(autoincrement())
  category_key String @db.Text
  pattern      String @db.Text
  tier         Int    @db.SmallInt
  priority     Int    @default(0) @db.SmallInt

  @@index([category_key])
  @@map("brand_rules")
}

// ---------------------------------------------------------------------------
// list_templates
// ---------------------------------------------------------------------------
model list_templates {
  id               Int     @id @default(autoincrement())
  perfil_hogar     String  @db.Text
  category_key     String  @db.Text
  item_name        String  @db.Text
  qty_base         Int     @default(1) @db.SmallInt
  scale_per_person Float   @default(0) @db.Real
  frequency_days   Int     @default(7) @db.SmallInt
  requires_module  String? @db.Text
  search_keyword   String? @db.Text
  size_hint        String? @db.Text
  incluye          Json?   @db.JsonB
  requiere_alguno  Json?   @db.JsonB
  excluye          Json?   @db.JsonB
  veta             Json?   @db.JsonB

  @@index([perfil_hogar])
  @@map("list_templates")
}

// ---------------------------------------------------------------------------
// user_profiles
// ---------------------------------------------------------------------------
model user_profiles {
  id                    Int      @id @default(autoincrement())
  nombre                String   @db.Text
  edad                  Int?     @db.SmallInt
  genero                String?  @db.Text
  hogar_tamano          Int      @default(1) @db.SmallInt
  hogar_chicos          Json?    @db.JsonB
  hogar_adultos_mayores Boolean  @default(false)
  hogar_mascotas        Json?    @db.JsonB
  tier_por_categoria    Json     @db.JsonB
  price_driven          Json?    @db.JsonB
  perfil_hogar          String   @db.Text
  nse_proxy             String?  @db.Text
  onboarding_done       Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  @@map("user_profiles")
}

// ---------------------------------------------------------------------------
// promo_offers
// ---------------------------------------------------------------------------
model promo_offers {
  id            Int     @id @default(autoincrement())
  super         String  @db.Text
  bank          String? @db.Text
  title         String? @db.Text
  description   String? @db.Text
  discount_pct  Int?
  installments  Int?
  interest_free Boolean?
  logo_url      String? @db.Text
  image_url     String? @db.Text
  validity      String? @db.Text
  source_url    String  @db.Text
  captured_at   BigInt

  @@index([super, captured_at])
  @@map("promo_offers")
}
