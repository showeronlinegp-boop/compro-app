// Prisma schema for compro-app — PostgreSQL target
// All model fields use snake_case to match the existing ProductRow / raw SQL contract.
// This avoids rewriting parseRow, types.ts, and the serialization layer (Slice B scope).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// users — identity anchor; keyed by Clerk user ID (JIT-provisioned on first
// authenticated request). No passwords or credential data stored here.
// ---------------------------------------------------------------------------
model users {
  id            Int      @id @default(autoincrement())
  clerk_user_id String   @unique @db.Text
  email         String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  cart      cart?
  shopping  shopping[]
  interests interests[]
  profile   user_profiles?

  fiado_clientes      fiado_clientes[]
  fiado_movimientos   fiado_movimientos[]
  fiado_recordatorios fiado_recordatorios[]
  fiado_ajustes       fiado_ajustes?

  test_notes test_notes[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// products
// ---------------------------------------------------------------------------
model products {
  id           Int      @id @default(autoincrement())
  super        String   @db.Text
  product_id   String   @db.Text
  sku_id       String?  @db.Text
  name         String   @db.Text
  barcode      String?  @db.Text
  image_url    String?  @db.Text
  product_url  String?  @db.Text
  raw_price    Float?   @db.DoublePrecision
  offer_price  Float?   @db.DoublePrecision
  discount_pct Int      @default(0)
  available    Boolean  @default(true)
  categories   Json?    @db.JsonB
  promotions   Json?    @db.JsonB
  synced_at    DateTime @default(now()) @db.Timestamptz(6)

  category_key String? @db.Text
  brand_tier   Int?    @db.SmallInt

  interests  interests[]
  shopping   shopping[]
  cart_items cart_items[]

  @@unique([super, product_id])
  @@index([super])
  @@index([discount_pct])
  @@index([category_key])
  @@index([brand_tier])
  @@map("products")
}

// ---------------------------------------------------------------------------
// interests
// ---------------------------------------------------------------------------
model interests {
  id         Int      @id @default(autoincrement())
  product_id Int
  user_id    Int
  added_at   DateTime @default(now()) @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([product_id])
  @@index([user_id])
  @@map("interests")
}

// ---------------------------------------------------------------------------
// shopping
// ---------------------------------------------------------------------------
model shopping {
  id             Int       @id @default(autoincrement())
  product_id     Int
  user_id        Int
  frequency_days Int       @default(7)
  last_bought    DateTime? @db.Timestamptz(6)
  notes          String?   @db.Text
  generated      Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([product_id])
  @@index([user_id])
  @@map("shopping")
}

// ---------------------------------------------------------------------------
// cart
// ---------------------------------------------------------------------------
model cart {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)
  items      cart_items[]

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("cart")
}

// ---------------------------------------------------------------------------
// cart_items
// ---------------------------------------------------------------------------
model cart_items {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int      @default(1) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz(6)

  cart    cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, product_id])
  @@index([cart_id])
  @@index([product_id])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// sync_log
// ---------------------------------------------------------------------------
model sync_log {
  id            Int       @id @default(autoincrement())
  super         String    @db.Text
  started_at    DateTime? @db.Timestamptz(6)
  finished_at   DateTime? @db.Timestamptz(6)
  product_count Int?
  status        String    @default("pending") @db.Text
  error         String?   @db.Text
  progress_leaf Int       @default(0)
  total_leaves  Int       @default(0)

  @@map("sync_log")
}

// ---------------------------------------------------------------------------
// brand_rules
// ---------------------------------------------------------------------------
model brand_rules {
  id           Int    @id @default(autoincrement())
  category_key String @db.Text
  pattern      String @db.Text
  tier         Int    @db.SmallInt
  priority     Int    @default(0) @db.SmallInt

  @@index([category_key])
  @@map("brand_rules")
}

// ---------------------------------------------------------------------------
// list_templates
// ---------------------------------------------------------------------------
model list_templates {
  id               Int     @id @default(autoincrement())
  perfil_hogar     String  @db.Text
  category_key     String  @db.Text
  item_name        String  @db.Text
  qty_base         Int     @default(1) @db.SmallInt
  scale_per_person Float   @default(0) @db.Real
  frequency_days   Int     @default(7) @db.SmallInt
  requires_module  String? @db.Text
  search_keyword   String? @db.Text
  size_hint        String? @db.Text
  incluye          Json?   @db.JsonB
  requiere_alguno  Json?   @db.JsonB
  excluye          Json?   @db.JsonB
  veta             Json?   @db.JsonB

  @@index([perfil_hogar])
  @@map("list_templates")
}

// ---------------------------------------------------------------------------
// user_profiles
// ---------------------------------------------------------------------------
model user_profiles {
  id                    Int      @id @default(autoincrement())
  user_id               Int      @unique
  nombre                String   @db.Text
  edad                  Int?     @db.SmallInt
  genero                String?  @db.Text
  hogar_tamano          Int      @default(1) @db.SmallInt
  hogar_chicos          Json?    @db.JsonB
  hogar_adultos_mayores Boolean  @default(false)
  hogar_mascotas        Json?    @db.JsonB
  tier_por_categoria    Json     @db.JsonB
  price_driven          Json?    @db.JsonB
  perfil_hogar          String   @db.Text
  nse_proxy             String?  @db.Text
  onboarding_done       Boolean  @default(false)
  postal_code           String?  @db.Text
  region_ids            Json?    @db.JsonB
  stores                Json?    @db.JsonB
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_profiles")
}

// ---------------------------------------------------------------------------
// promo_offers
// ---------------------------------------------------------------------------
model promo_offers {
  id            Int      @id @default(autoincrement())
  super         String   @db.Text
  bank          String?  @db.Text
  title         String?  @db.Text
  description   String?  @db.Text
  discount_pct  Int?
  installments  Int?
  interest_free Boolean?
  logo_url      String?  @db.Text
  image_url     String?  @db.Text
  validity      String?  @db.Text
  source_url    String   @db.Text
  captured_at   BigInt

  @@index([super, captured_at])
  @@map("promo_offers")
}

// ===========================================================================
// Módulo Fiado (openspec/changes/fiado). Todo tiene dueño (user_id).
// ===========================================================================

// ---------------------------------------------------------------------------
// fiado_clientes — clientes a los que el comercio les fía
// ---------------------------------------------------------------------------
model fiado_clientes {
  id            Int       @id @default(autoincrement())
  user_id       Int
  nombre        String    @db.Text
  telefono      String?   @db.Text
  etiqueta      String?   @db.Text
  /// Límite de fiado en pesos. Informa, no bloquea.
  limite        Int?
  proximo_cobro DateTime? @db.Date
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  user          users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  movimientos   fiado_movimientos[]
  recordatorios fiado_recordatorios[]

  @@index([user_id, nombre])
  @@map("fiado_clientes")
}

// ---------------------------------------------------------------------------
// fiado_movimientos — libro APPEND-ONLY (un trigger bloquea UPDATE y DELETE
// directos). `monto` es el efecto con signo sobre lo que te deben:
// fiado > 0, pago < 0, correccion = −(monto del corregido).
// ---------------------------------------------------------------------------
model fiado_movimientos {
  id              Int      @id @default(autoincrement())
  user_id         Int
  cliente_id      Int
  /// 'fiado' | 'pago' | 'correccion' (CHECK en la migración)
  tipo            String   @db.Text
  monto           Int
  /// Movimiento que esta corrección deshace. Único: se corrige una sola vez.
  corrige_id      Int?     @unique
  nota            String?  @db.Text
  /// Evita duplicados por doble toque o reintento de red.
  idempotency_key String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  user      users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cliente   fiado_clientes     @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  corrige   fiado_movimientos? @relation("correccion", fields: [corrige_id], references: [id], onDelete: Cascade)
  corregido fiado_movimientos? @relation("correccion")

  @@unique([user_id, idempotency_key])
  @@index([user_id, cliente_id, created_at])
  @@map("fiado_movimientos")
}

// ---------------------------------------------------------------------------
// fiado_recordatorios — cuándo se le recordó el pago a un cliente
// ---------------------------------------------------------------------------
model fiado_recordatorios {
  id         Int      @id @default(autoincrement())
  user_id    Int
  cliente_id Int
  enviado_at DateTime @default(now()) @db.Timestamptz(6)

  user    users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cliente fiado_clientes @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@index([user_id, cliente_id, enviado_at])
  @@map("fiado_recordatorios")
}

// ---------------------------------------------------------------------------
// fiado_ajustes — una fila por usuario. Plantilla null = texto por defecto.
// ---------------------------------------------------------------------------
model fiado_ajustes {
  user_id                Int      @id
  comercio               String   @default("") @db.Text
  alias                  String?  @db.Text
  dias_deuda_vieja       Int      @default(30)
  plantilla_fiado        String?  @db.Text
  plantilla_pago         String?  @db.Text
  plantilla_recordatorio String?  @db.Text
  updated_at             DateTime @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("fiado_ajustes")
}

// ---------------------------------------------------------------------------
// test_notes — notas de prueba (herramienta solo de desarrollo local; las rutas
// existen únicamente con TEST_NOTES_ENABLED=1). Notas COMPARTIDAS entre cuentas:
// user_id es solo el AUTOR (se fija al crear). tipo/estado son VARCHAR con CHECK
// en el SQL de la migración (Prisma no los modela); la fuente de verdad de los
// valores válidos es modules/test-notes/domain/test-note.ts.
// ---------------------------------------------------------------------------
model test_notes {
  id          Int       @id @default(autoincrement())
  user_id     Int
  tipo        String    @default("error") @db.VarChar(20)
  estado      String    @default("abierta") @db.VarChar(20)
  texto       String    @db.Text
  ruta        String    @db.VarChar(500)
  pantalla    String?   @db.VarChar(200)
  selector    String?   @db.Text
  elemento    String?   @db.Text
  pos_x       Float?    @db.DoublePrecision // fracción del ancho de <main>
  pos_y       Int? // px desde el tope del contenido de <main>
  viewport_w  Int? // ancho de la ventana (dato informativo)
  contexto    Json?
  modo        String[]  @default([])
  respuesta   String?   @db.Text
  resuelta_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade) // autor

  @@index([estado, created_at])
  @@index([ruta])
  @@map("test_notes")
}
