{
  "name": "compro-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:wait": "tsx scripts/wait-for-postgres.ts",
    "db:migrate": "prisma migrate deploy",
    "db:test:setup": "tsx scripts/db-test-setup.ts",
    "dev": "npm run db:up && npm run db:wait && npm run db:migrate && tsx watch src/main.ts",
    "dev:only": "tsx watch src/main.ts",
    "migrate:etl": "tsx scripts/migrate-sqlite-to-pg.ts",
    "sync": "tsx scripts/sync.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/main.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "node-cron": "^3.0.3",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^9.6.0",
    "prisma": "^7.8.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}
